# Firebase (leave empty to run in local mode: the site uses the bundled content
# and edits are stored in your browser only)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID=

# Super admin(s): full control, manages admins in Dashboard > Access.
# Must match isSuper() in firestore.rules. Other editors are added in the dashboard.
SUPER_ADMIN_EMAILS=abdullahalmazid.bd@gmail.com

# Cloudinary unsigned upload (optional; without it you can paste image URLs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
