# ---------------------------------------------------------------
# Secrets and keys: never commit these.
# ---------------------------------------------------------------
# Environment files (Firebase keys, Cloudinary preset, admin emails…).
# Only the template .env.example is committed.
.env
.env.*
!.env.example

# Service accounts and private keys (Firebase Admin SDK, Google Cloud, SSH, TLS)
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json
firebase-adminsdk*.json
credentials*.json
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*

# ---------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.next/
out/
build/
dist/
coverage/
next-env.d.ts
*.tsbuildinfo

# ---------------------------------------------------------------
# Hosting and tool caches
# ---------------------------------------------------------------
.vercel/
.netlify/
.firebase/
.turbo/
.eslintcache
.cache/

# ---------------------------------------------------------------
# Logs and debug files
# ---------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
firebase-debug.log*
firebase-debug.*.log*
firestore-debug.log*
ui-debug.log*

# ---------------------------------------------------------------
# Editor and OS files
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Local scratch files
.fbcheck.mjs
*.local.md
